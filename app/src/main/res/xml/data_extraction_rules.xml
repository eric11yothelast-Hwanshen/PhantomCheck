<?xml version="1.0" encoding="utf-8"?>
<!--
  R17: Android 12+ 備份/轉移規則。
  allowBackup=false 已關閉雲端備份；本檔再把 device-to-device 轉移與 adb backup 一併收斂，
  避免加密金鑰、聊天資料與 API 金鑰被整包帶走。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
